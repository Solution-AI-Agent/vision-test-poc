{
  "name": "vision-qa-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace @vision-qa/platform",
    "start": "npm run start --workspace @vision-qa/platform",
    "build": "tsc --noEmit && npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:ui": "tsx scripts/ui-check.ts",
    "platform:build": "npm run build --workspace @vision-qa/platform",
    "sample:dev": "npm run dev --workspace @vision-qa/sample",
    "sample:build": "npm run build --workspace @vision-qa/sample",
    "sample:start": "npm run start --workspace @vision-qa/sample",
    "sample:test": "npm run test:functional --workspace @vision-qa/sample",
    "evidence:restore": "node evidence/restore.mjs",
    "evidence:check": "node evidence/restore.mjs --check",
    "media:serve": "tsx scripts/media-serve.ts",
    "doctor": "tsx scripts/runtime-doctor.ts"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "@playwright/test": "^1.63.0",
    "zod": "^4.6.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.3",
    "@midscene/web": "1.14.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "sample-site"
  ],
  "engines": {
    "node": ">=24"
  }
}
